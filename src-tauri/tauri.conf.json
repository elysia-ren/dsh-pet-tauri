{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-pet",
  "version": "0.2.0",
  "identifier": "com.dshpet.standalone",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "dsh-pet",
        "width": 924,
        "height": 722,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true
      },
      {
        "label": "settings",
        "title": "dsh-pet 设置",
        "url": "settings.html",
        "width": 800,
        "height": 720,
        "minWidth": 680,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/dsh-pet-tauri/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
